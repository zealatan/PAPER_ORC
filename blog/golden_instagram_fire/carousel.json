{
  "name": "golden_instagram_fire",
  "platform": "instagram",
  "format": "carousel",
  "canvas": {
    "width": 1080,
    "height": 1350,
    "aspect_ratio": "4:5"
  },
  "slide_order": [
    "backtest",
    "table"
  ],
  "assets": {
    "data": "assets/data/<ticker>_fires.json",
    "logo": "assets/logos/<ticker>_logo.png"
  },
  "output": {
    "directory": "exports",
    "filename": "<number>-<slide>.png"
  }
}
