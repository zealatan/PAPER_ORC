{
  "name": "@motion-studio/hero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "High-end cinematic hero video (720x1280/15fps) built on the existing engine.",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "hero:generate": "tsx src/cli.ts generate",
    "hero:preview": "tsx src/cli.ts preview",
    "hero:render": "tsx src/cli.ts render",
    "hero:validate": "tsx src/cli.ts validate",
    "hero:gallery": "tsx src/cli.ts gallery",
    "hero:all": "tsx src/cli.ts all"
  },
  "dependencies": {
    "@motion-studio/components": "workspace:*",
    "@motion-studio/core": "workspace:*",
    "@motion-studio/renderer": "workspace:*",
    "@motion-studio/renderer-core": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.1"
  }
}
