{
  "name": "youtube-motion-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first, JSON-driven, AI-compatible motion graphics editor for vertical YouTube Shorts.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @motion-studio/editor dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "examples:generate": "pnpm --filter @motion-studio/examples run examples:generate",
    "examples:preview": "pnpm --filter @motion-studio/examples run examples:preview",
    "examples:render": "pnpm --filter @motion-studio/examples run examples:render",
    "examples:validate": "pnpm --filter @motion-studio/examples run examples:validate",
    "examples:gallery": "pnpm --filter @motion-studio/examples run examples:gallery",
    "examples:all": "pnpm --filter @motion-studio/examples run examples:all",
    "showcase:generate": "pnpm --filter @motion-studio/showcase run showcase:generate",
    "showcase:preview": "pnpm --filter @motion-studio/showcase run showcase:preview",
    "showcase:render": "pnpm --filter @motion-studio/showcase run showcase:render",
    "showcase:validate": "pnpm --filter @motion-studio/showcase run showcase:validate",
    "showcase:gallery": "pnpm --filter @motion-studio/showcase run showcase:gallery",
    "showcase:all": "pnpm --filter @motion-studio/showcase run showcase:all",
    "scenarios:generate": "pnpm --filter @motion-studio/scenarios run scenarios:generate",
    "scenarios:preview": "pnpm --filter @motion-studio/scenarios run scenarios:preview",
    "scenarios:render": "pnpm --filter @motion-studio/scenarios run scenarios:render",
    "scenarios:validate": "pnpm --filter @motion-studio/scenarios run scenarios:validate",
    "scenarios:gallery": "pnpm --filter @motion-studio/scenarios run scenarios:gallery",
    "scenarios:all": "pnpm --filter @motion-studio/scenarios run scenarios:all",
    "ultimate:generate": "pnpm --filter @motion-studio/ultimate run ultimate:generate",
    "ultimate:preview": "pnpm --filter @motion-studio/ultimate run ultimate:preview",
    "ultimate:render": "pnpm --filter @motion-studio/ultimate run ultimate:render",
    "ultimate:validate": "pnpm --filter @motion-studio/ultimate run ultimate:validate",
    "ultimate:gallery": "pnpm --filter @motion-studio/ultimate run ultimate:gallery",
    "ultimate:all": "pnpm --filter @motion-studio/ultimate run ultimate:all",
    "journey:generate": "pnpm --filter @motion-studio/journey run journey:generate",
    "journey:preview": "pnpm --filter @motion-studio/journey run journey:preview",
    "journey:render": "pnpm --filter @motion-studio/journey run journey:render",
    "journey:validate": "pnpm --filter @motion-studio/journey run journey:validate",
    "journey:gallery": "pnpm --filter @motion-studio/journey run journey:gallery",
    "journey:all": "pnpm --filter @motion-studio/journey run journey:all",
    "hero:generate": "pnpm --filter @motion-studio/hero run hero:generate",
    "hero:preview": "pnpm --filter @motion-studio/hero run hero:preview",
    "hero:render": "pnpm --filter @motion-studio/hero run hero:render",
    "hero:validate": "pnpm --filter @motion-studio/hero run hero:validate",
    "hero:gallery": "pnpm --filter @motion-studio/hero run hero:gallery",
    "hero:all": "pnpm --filter @motion-studio/hero run hero:all",
    "oneshot:generate": "pnpm --filter @motion-studio/oneshot run oneshot:generate",
    "oneshot:preview": "pnpm --filter @motion-studio/oneshot run oneshot:preview",
    "oneshot:render": "pnpm --filter @motion-studio/oneshot run oneshot:render",
    "oneshot:validate": "pnpm --filter @motion-studio/oneshot run oneshot:validate",
    "oneshot:gallery": "pnpm --filter @motion-studio/oneshot run oneshot:gallery",
    "oneshot:all": "pnpm --filter @motion-studio/oneshot run oneshot:all"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.3"
  }
}
