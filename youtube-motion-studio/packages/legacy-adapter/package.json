{
  "name": "@motion-studio/legacy-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Import legacy HTML/JSON video decks (e.g. the PG deck) into MotionProject data (spec §26).",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@motion-studio/core": "workspace:*"
  }
}
