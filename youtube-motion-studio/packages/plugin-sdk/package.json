{
  "name": "@motion-studio/plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plugin manifest, API, and host: reversible, version-checked, permission-gated plugins.",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@motion-studio/components": "workspace:*",
    "@motion-studio/core": "workspace:*",
    "@motion-studio/renderer-core": "workspace:*",
    "zod": "^3.23.8"
  }
}
